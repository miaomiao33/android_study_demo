<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello World!"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="跳转到第二个activity"
            android:onClick="onclickCallBack"/>
    </LinearLayout>

    <Button
        android:id="@+id/bt2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳转到广播"
        android:onClick="onclickCallBackService"/>
    <Button
        android:id="@+id/bt_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳转到高德地图"
        android:onClick="onclickCallBackMap"/>
    <Button
        android:id="@+id/bt_glide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳转到glide的使用"
        android:onClick="onclickCallBackGlide"/>
    <Button
        android:id="@+id/bt_okHttp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳转到okHttp的使用"
        android:onClick="onclickCallBackOkHttp"/>
    <Button
        android:id="@+id/bt_rxJava"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳转到RXJava的使用"
        android:onClick="gotoRxJava"/>
    <Button
        android:id="@+id/bt_Intent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳转到Intent使用，包含url、拨号键盘"
        />
    <Button
        android:id="@+id/bt_Storage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳转到存储使用"
        />
    <Button
        android:id="@+id/bt_fragment_with_Broadcast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳转到Fragment和静态动态广播使用"
        />

</LinearLayout>