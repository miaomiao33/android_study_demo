<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".opencv.ffmpegUsage.livePush.CameraView.LivePushCameraMainActivity">
    <com.example.android_study_demo_project.opencv.ffmpegUsage.livePush.CameraView.LivePushCameraView
        android:id="@+id/live_push_camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:id="@+id/tv_camera_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bt_live_push_camera_start"/>
<!--    <Button-->
<!--        android:id="@+id/bt_live_push_camera_start"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="开始录制"-->
<!--        android:layout_marginBottom="40dp"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"/>-->
    <com.example.android_study_demo_project.opencv.ffmpegUsage.livePush.CameraView.RecordProgressButton
        android:id="@+id/bt_live_push_camera_start"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:text="开始录制"
        android:layout_marginBottom="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>